# Gleo environment variables
# Place this file at the plugin root as `.env` (no extension change other than removing .example).
# These can also be defined as PHP constants in wp-config.php using the same names.
# Settings UI overrides are stored in the WP options table; this file takes precedence over UI but is overridden by wp-config.php constants.

# Google Gemini API key — get yours at https://aistudio.google.com/
GLEO_GEMINI_API_KEY=

# Tavily API key — get yours at https://tavily.com/
GLEO_TAVILY_API_KEY=
